{
  "name": "flaneur-osm-recorder",
  "version": "1.1.0-alpha.1",
  "type": "module",
  "description": "A mobile-first PWA for field survey data collection compatible with JOSM/OpenStreetMap",
  "license": "GPL-3.0-or-later",
  "author": "Flaneur OSM Contributors",
  "homepage": "https://github.com/Open-Security-Mapping-Project/flaneur-osm-recorder",
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Security-Mapping-Project/flaneur-osm-recorder.git"
  },
  "bugs": {
    "url": "https://github.com/Open-Security-Mapping-Project/flaneur-osm-recorder/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "node tests/storage.test.mjs && node tests/export.test.mjs && node tests/icons.test.mjs",
    "icons:fetch": "node tools/fetch-icons.mjs",
    "icons:credits": "node tools/build-credits.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.2.5",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
